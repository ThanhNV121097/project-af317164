# Local database user for docker compose.
POSTGRES_USER=app

# Local database password for docker compose. Change outside repository.
POSTGRES_PASSWORD=app_secret

# Local database name for docker compose.
POSTGRES_DB=app

# Host port mapped to backend container port 8080.
BACKEND_PORT=8080

# Host port mapped to frontend container port 3000.
FRONTEND_PORT=3000

# Browser-visible backend base URL used by frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080
